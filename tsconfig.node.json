{
  "compilerOptions": {
    "target": "ES2022",
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "vite.config.ts",
    "server",
    "src/rules.ts", "src/catalog.ts",
    "src/types.ts",
    "src/security.ts",
    "src/support.ts",
    "src/phone.ts"
  ]
}
